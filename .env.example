# Public HTTPS origin used by Claude / ChatGPT to connect to the MCP endpoint
# and by the widget iframe to stream /stream/* /cover/* /lrc/*.
# Required in production (NODE_ENV=production).
PUBLIC_BASE_URL=https://music.example.com
PORT=3000

# Streamable HTTP MCP route. /mcp is always kept as an alias for local smoke tests.
MCP_HTTP_PATH=/mcp/music

# CORS allowlist (comma separated). Defaults to the PUBLIC_BASE_URL origin.
ALLOWED_ORIGINS=https://music.example.com

# Allowed Host header names (not URLs), comma separated. Defaults to the
# hostname from PUBLIC_BASE_URL plus localhost/loopback for health checks.
ALLOWED_HOSTS=music.example.com

# Meting-compatible API endpoint (https://github.com/metowolf/Meting style).
METING_API_BASE=https://api.qijieya.cn/meting/

# Default music platform: netease | tencent | kugou | kuwo | baidu
DEFAULT_MUSIC_SERVER=netease

# Usually leave this empty. The MCP Apps host will provide its own sandbox.
# Only set a dedicated HTTPS origin after that origin is actually deployed.
MCP_WIDGET_DOMAIN=

# Redirects from a trusted Meting endpoint to private/special-use IP ranges are
# blocked by default. Enable only for a deliberately private media backend.
METING_ALLOW_PRIVATE_REDIRECTS=false

# Optional OAuth password gate for remote connectors.
# Leave empty to disable auth; set a password to enable Authorization Code auth.
MCP_AUTH_PASSWORD=
# Stable high-entropy token signing secret. Keep it unchanged across upgrades.
# If omitted, MCP_AUTH_PASSWORD is used for backward compatibility.
MCP_AUTH_TOKEN_SECRET=
# Optional display name on the OAuth password page.
MCP_AUTH_SERVICE_NAME=music-mcp

# OAuth audience/scope policy. Set resource omission to false after confirming
# every connector sends RFC 8707 `resource`.
MCP_OAUTH_SCOPE=tools:read
MCP_OAUTH_ALLOW_LEGACY_RESOURCE_OMISSION=true
